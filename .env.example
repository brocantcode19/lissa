# ─── LISSA Environment Variables ───────────────────────────────────────────
# Copy this to .env and fill in your values.
# NEVER commit .env to GitHub. Only commit .env.example

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URL=mongodb://mongodb:27017/lissa
# Node.js MongoDB example connection string:
MONGODB_URI=mongodb+srv://sorrondajebray2005_db_user:nrCMnu7TyTUbu7ar@lissa-cluster.6a4zrgs.mongodb.net

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=lissa-kb

# ── App ───────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development

# ── Inngest (Week 2 - leave as-is for now) ────────────────────────────────────
INNGEST_EVENT_KEY=local
INNGEST_SIGNING_KEY=local
INNGEST_DEV_SERVER_URL=http://inngest:8288
